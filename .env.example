# Smart Circuit Environment Variables
# Copy this file to .env and fill in the values

# Gemini API key (optional, for LLM features)
GEMINI_API_KEY=

# Server port
PORT=3001

# PostgreSQL credentials
POSTGRES_DB=smartcircuit
POSTGRES_USER=smartcircuit
POSTGRES_PASSWORD=smartcircuitpass
DATABASE_URL=postgresql://smartcircuit:smartcircuitpass@postgres:5432/smartcircuit
